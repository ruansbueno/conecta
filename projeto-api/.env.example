# Conexão com o PostgreSQL. Em dev aponta para o container do docker-compose;
# em produção, para o banco do servidor da faculdade.
DATABASE_URL=postgresql+asyncpg://conecta:conecta@localhost:5433/conecta_dev

# Provedor de credenciais: mock (usuários de teste) ou moodle (integração real).
AUTH_PROVIDER=mock

# Segredo de assinatura do JWT. Gere um valor longo e aleatório por ambiente.
JWT_SECRET=troque-por-um-segredo-local-de-desenvolvimento
JWT_EXPIRES_SECONDS=86400

# Integração real com o Moodle (só quando AUTH_PROVIDER=moodle).
# MOODLE_URL=
