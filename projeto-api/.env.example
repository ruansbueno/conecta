# Conexão com o PostgreSQL. Em dev aponta para o container do docker-compose;
# em produção, para o banco do servidor da faculdade.
DATABASE_URL=postgresql+asyncpg://conecta:conecta@localhost:5433/conecta_dev

# Provedor de credenciais: mock (usuários de teste) ou ifsul (API de autenticação do IFSul).
AUTH_PROVIDER=mock

# Segredo de assinatura do JWT (mínimo 32 bytes). Gere um por ambiente com:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# A API recusa subir com o valor abaixo.
JWT_SECRET=troque-por-um-segredo-local-de-desenvolvimento
JWT_EXPIRES_SECONDS=86400

# Chave do HMAC que prende o token CSRF à sessão web (RF-33). Gere como a do JWT, com outro valor:
# a API recusa subir com o valor abaixo ou com o mesmo valor do JWT_SECRET.
CSRF_SECRET=troque-por-outro-segredo-local-so-para-o-csrf

# API de autenticação do IFSul (só quando AUTH_PROVIDER=ifsul). Em produção, HTTPS. A URL atual
# da instituição usa HTTP, que manda a senha institucional em claro: só é aceita com
# IFSUL_AUTH_PERMITIR_HTTP=true, para teste.
# IFSUL_AUTH_URL=http://200.19.1.19/luissilva/Conecta_API_REST/public/api/v1/autenticacoes
# IFSUL_AUTH_PERMITIR_HTTP=false
